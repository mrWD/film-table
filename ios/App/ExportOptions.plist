<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- TestFlight and the store are the same export; the difference is what happens
       after the upload, not how the archive is signed. -->
  <key>method</key><string>app-store-connect</string>
  <key>teamID</key><string>742H5JJX37</string>
  <key>signingStyle</key><string>automatic</string>
  <!-- Symbols go up so a crash report from a tester is readable. -->
  <key>uploadSymbols</key><true/>
  <key>destination</key><string>export</string>
</dict>
</plist>
